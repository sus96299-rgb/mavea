# ==================== Python ====================
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
*.egg
build/
dist/
.eggs/
pip-wheel-metadata/

# ==================== 虚拟环境 ====================
.venv/
venv/
env/
ENV/

# ==================== 环境变量（含 API Key，禁止提交）====================
.env
.env.local
.env.*.local

# ==================== IDE ====================
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# ==================== 测试与覆盖率 ====================
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# ==================== 模型文件 ====================
models/
*.pt
*.pth
*.bin
*.onnx
*.safetensors
whisper-model/
# faster-whisper 模型缓存
.cache/

# ==================== 向量数据库 ====================
data/vector_db/**
!data/vector_db/.gitkeep
chroma_db/

# ==================== 工作区文件（大文件/用户数据）====================
workspace/**
!workspace/.gitkeep
!workspace/output/.gitkeep
!workspace/temp/.gitkeep

# ==================== 视频/音频素材 ====================
*.mp4
*.mov
*.avi
*.mkv
*.webm
*.mp3
*.wav
*.aac
*.flac
*.m4a

# ==================== 图片（保留 docs 和 examples 下的）====================
*.jpg
*.jpeg
*.png
*.gif
!docs/**/*.png
!docs/**/*.jpg
!examples/**/*.png
!examples/**/*.jpg

# ==================== 其他 ====================
*.log
TROUBLESHOOTING_LOCAL.md

# Windows 缩略图缓存
Thumbs.db
