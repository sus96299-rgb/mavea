# ==================== MAVEA 环境变量模板 ====================
# 复制本文件为 .env 并填入真实值：copy .env.example .env
# .env 文件已在 .gitignore 中，不会被提交
# 注意：嵌套配置用双下划线 __ 分隔，不要写成单下划线

# ---- LLM 提供方选择 ----
# deepseek / qwen / openai
# 免费方案推荐：qwen（通义千问新用户有免费额度）
MAVEA_LLM__PROVIDER=qwen

# ---- DeepSeek（极便宜，几块钱够用很久）----
# 获取地址：https://platform.deepseek.com/api_keys
MAVEA_LLM__DEEPSEEK_API_KEY=
MAVEA_LLM__DEEPSEEK_MODEL=deepseek-chat

# ---- 阿里通义千问（新用户有免费额度，支持视觉理解）----
# 获取地址：https://dashscope.console.aliyun.com/apiKey
# 免费方案：只填这个就行，PROVIDER设为qwen
MAVEA_LLM__QWEN_API_KEY=
MAVEA_LLM__QWEN_MODEL=qwen-plus
MAVEA_LLM__QWEN_VL_MODEL=qwen-vl-max
MAVEA_LLM__QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ---- OpenAI 兼容接口（可接硅基流动等免费中转）----
MAVEA_LLM__OPENAI_API_KEY=
MAVEA_LLM__OPENAI_MODEL=gpt-4o-mini
MAVEA_LLM__OPENAI_BASE_URL=https://api.openai.com/v1

# ---- 视频处理 ----
MAVEA_VIDEO__SCENE_THRESHOLD=27.0
MAVEA_VIDEO__WHISPER_MODEL_SIZE=base
MAVEA_VIDEO__WHISPER_DEVICE=cpu
# 跳过语音转写（测试时设为 true 可避免下载 Whisper 模型）
MAVEA_VIDEO__SKIP_TRANSCRIBE=false
# HuggingFace 国内镜像（自动设置 HF_ENDPOINT）
MAVEA_VIDEO__HF_MIRROR=https://hf-mirror.com

# ---- 路径配置 ----
MAVEA_WORKSPACE_DIR=./workspace
MAVEA_LOG_LEVEL=INFO

# ---- MCP Server ----
MAVEA_MCP__SSE_HOST=127.0.0.1
MAVEA_MCP__SSE_PORT=8765

# ---- FastAPI ----
MAVEA_API__HOST=127.0.0.1
MAVEA_API__PORT=8000

# ---- Gradio WebUI ----
MAVEA_GRADIO__HOST=127.0.0.1
MAVEA_GRADIO__PORT=7860
# 设为 true 可生成公网分享链接（调试用）
MAVEA_GRADIO__SHARE=false
